<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Don't create localization (en-US, etc) folders with resources -->
    <!-- https://github.com/dotnet/fsharp/issues/6007#issuecomment-547041463 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RollForward>Major</RollForward>
    <ToolCommandName>fantomas</ToolCommandName>
    <PackAsTool>True</PackAsTool>
    <AssemblyName>fantomas</AssemblyName>
    <IsPackable>true</IsPackable>
    <RootNamespace>Fantomas</RootNamespace>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <!--
    `FantomasAot` is set by the `TestAot` and `Release` pipelines of build.fsx: the tool is published
    with Native AOT, and packed as one package per platform.
    https://github.com/fsprojects/fantomas/issues/3171
    `dotnet pack -p:FantomasAot=true` gives the top-level `fantomas` package, which only names the
    platform packages, and `fantomas.linux-x64`, which holds the native executable. The SDK packs
    only the platforms the machine it runs on can compile for, so each further platform needs a
    runner of its own: `fantomas.linux-musl-x64`, for Alpine, is packed on Alpine with
    `dotnet pack -r linux-musl-x64 -p:FantomasAot=true`. `dotnet pack -r any -p:FantomasAot=true`
    gives `fantomas.any`, the tool without Native AOT, which every other platform installs.
  -->
  <PropertyGroup Condition="'$(FantomasAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <ToolPackageRuntimeIdentifiers>linux-x64;linux-musl-x64;any</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>$(ToolPackageRuntimeIdentifiers)</RuntimeIdentifiers>
    <!-- The native debug symbols and the XML documentation are no use to someone running the tool. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fantomas.Client\Fantomas.Client.fsproj" />
    <ProjectReference Include="..\Fantomas.Daemon.Contract\Fantomas.Daemon.Contract.csproj" />
    <ProjectReference Include="..\Fantomas.Core\Fantomas.Core.fsproj" />
    <ProjectReference Include="..\Fantomas.EditorConfig\Fantomas.EditorConfig.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fsi" />
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Theme.fsi" />
    <Compile Include="Theme.fs" />
    <Compile Include="Invocation.fsi" />
    <Compile Include="Invocation.fs" />
    <Compile Include="Logging.fsi" />
    <Compile Include="Logging.fs" />
    <Compile Include="Diagnostics.fsi" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="IgnoreFile.fsi" />
    <Compile Include="IgnoreFile.fs" />
    <Compile Include="EditorConfigFiles.fsi" />
    <Compile Include="EditorConfigFiles.fs" />
    <Compile Include="EditorConfigReport.fsi" />
    <Compile Include="EditorConfigReport.fs" />
    <Compile Include="DaemonJson.fsi" />
    <Compile Include="DaemonJson.fs" />
    <Compile Include="Daemon.fsi" />
    <Compile Include="Daemon.fs" />
    <Compile Include="Cli.fsi" />
    <Compile Include="Cli.fs" />
    <Compile Include="Paths.fsi" />
    <Compile Include="Paths.fs" />
    <Compile Include="Arguments.fsi" />
    <Compile Include="Arguments.fs" />
    <Compile Include="HelpPage.fsi" />
    <Compile Include="HelpPage.fs" />
    <Compile Include="CommandResult.fsi" />
    <Compile Include="CommandResult.fs" />
    <Compile Include="Plan.fsi" />
    <Compile Include="Plan.fs" />
    <Compile Include="FormatCommand.fsi" />
    <Compile Include="FormatCommand.fs" />
    <Compile Include="CheckCommand.fsi" />
    <Compile Include="CheckCommand.fs" />
    <Compile Include="DaemonCommand.fsi" />
    <Compile Include="DaemonCommand.fs" />
    <Compile Include="ProfileCommand.fsi" />
    <Compile Include="ProfileCommand.fs" />
    <Compile Include="DoctorCommand.fsi" />
    <Compile Include="DoctorCommand.fs" />
    <Compile Include="Report.fsi" />
    <Compile Include="Report.fs" />
    <Compile Include="JsonReport.fsi" />
    <Compile Include="JsonReport.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Serilog"  />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="editorconfig" />
    <PackageReference Include="Ignore" />
    <PackageReference Include="System.IO.Abstractions" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
</Project>
